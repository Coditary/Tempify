{
  "formatVersion": 1,
  "name": "tempify-cli",
  "version": @VERSION@,
  "release": 1,
  "revision": 0,
  "summary": "Tempify template engine CLI",
  "description": "Local-first template engine CLI with bundled ReqPack Tempify plugin.",
  "license": "MIT",
  "architecture": @ARCHITECTURE@,
  "system": [@SYSTEM@],
  "vendor": "Coditary",
  "maintainerEmail": "Matographo@gmail.com",
  "url": @URL@,
  "homepage": "https://github.com/Coditary/Tempify",
  "sourceUrl": "https://github.com/Coditary/Tempify",
  "buildDate": @BUILD_DATE@,
  "tags": ["cli", "templating", "tempify", "reqpack"],
  "binaries": ["tempify"],
  "payload": {
    "path": "payload/payload.tar.zst",
    "archive": "tar",
    "compression": "zstd",
    "hashAlgorithm": "sha256",
    "hashFile": "hashes/payload.sha256",
    "sizeCompressed": @SIZE_COMPRESSED@,
    "sizeInstalledExpected": @SIZE_INSTALLED_EXPECTED@
  }
}
